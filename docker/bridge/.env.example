# Bridge server settings.
PORT=8787

# Shared secret required on every request (header "x-bridge-token" or
# "?token=" query param). Generate a long random value, e.g.:
#   openssl rand -hex 32
# Required before any Tailscale Funnel exposure - never leave this unset
# once the bridge is reachable beyond localhost.
BRIDGE_TOKEN=change-me-to-a-long-random-string

// tetherd connection: bt_* commands (threads/messages/send/status) only
// answer over tetherd's local UNIX socket, never TCP — see
// docker/bridge/src/tetherClient.js for why. This path must match the
// shared volume mount in docker-compose.yml (bridge + tetherd both mount
// the same host directory here).
TETHER_SOCKET=/run/user/0/tether/tetherd.sock
